# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Maven build output
target/

# Spring Modulith output when an IDE compiles outside the Maven project directory
build/

# Web dependencies, build output, and Playwright results
node_modules/
dist/
test-results/
playwright-report/

# Generated from backend/openapi.json before every web build and test
web/src/api/schema.ts

# Source files kept locally, such as USAspending archive downloads (infra/compose/mirror-archive.sh)
/data/

# Terraform working directories, local state (the bootstrap root's), and variable files, which hold personal values
# such as alert emails. Each root's .terraform.lock.hcl is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Claude Code's local preview configuration
.claude/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Ignore Starting project idea
/project


# Env
*.env

#vscode
.vscode/