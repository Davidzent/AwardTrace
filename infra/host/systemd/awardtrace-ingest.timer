# Starts awardtrace-ingest.service weekly. USAspending publishes a delta monthly and keeps only the latest one (doc
# 03), so a weekly run never misses one, and a file already stored is never downloaded again. Mondays at 18:00 UTC
# fall inside the host's weekday hours in both Pacific standard and daylight time (ADR 0017), so the run never races
# the stack's boot. It follows the backup that runs when the host starts, so a bad ingest can be undone from that
# morning's dump.
[Unit]
Description=Ingest the latest USAspending delta weekly

[Timer]
OnCalendar=Mon *-*-* 18:00:00 UTC
RandomizedDelaySec=15min
# A Monday spent stopped, to save money, is made up at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
