{
  "name": "awardtrace-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.ts",
    "predev": "npm run generate:api",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview:landing": "vite preview --config vite.landing.config.ts",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc",
    "lint": "eslint .",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
